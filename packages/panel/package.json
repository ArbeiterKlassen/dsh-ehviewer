{
  "name": "dsh-ehviewer-panel",
  "version": "1.0.0",
  "type": "module",
  "description": "Local read-only viewer panel for dsh-ehviewer: history, downloads, notes, library, in-panel reader",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "bin": { "dsh-ehviewer-panel": "./server.mjs" },
  "exports": {
    ".": "./server.mjs",
    "./server": "./server.mjs",
    "./online": "./online.mjs",
    "./package.json": "./package.json"
  },
  "files": ["server.mjs", "online.mjs", "public"],
  "scripts": { "start": "node server.mjs" },
  "dependencies": { "dsh-ehviewer": "^1.0.0" }
}
