{
  "name": "dsh-ehviewer",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server for e-hentai / exhentai — search, read, download, annotate, with a local library index",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "bin": { "dsh-ehviewer": "./src/index.js" },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./config": "./src/config.js",
    "./http": "./src/http.js",
    "./auth": "./src/auth.js",
    "./gallery": "./src/gallery.js",
    "./pages": "./src/pages.js",
    "./browse": "./src/browse.js",
    "./download": "./src/download.js",
    "./store": "./src/store.js",
    "./subs": "./src/subs.js",
    "./local-index": "./src/local-index.js",
    "./notes": "./src/notes.js",
    "./tags": "./src/tags.js",
    "./package.json": "./package.json"
  },
  "files": ["src", "scripts", "!src/*.md"],
  "scripts": {
    "start": "node src/index.js",
    "smoke": "node test/smoke.mjs",
    "test": "node test/run-offline.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "cheerio": "^1.0.0",
    "socks-proxy-agent": "^8.0.5",
    "undici": "^7.13.0",
    "zod": "^4.1.0"
  }
}
